{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qitong/EmulatRx/blob/main/schemas/public-metadata-receipt-v1.schema.json",
  "title": "EmulatRx public registration source receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nctId", "recordUrl", "requestUrls", "retrievedAtUtc", "apiVersion",
    "dataTimestamp", "requestedLeafPaths", "projectedLeafPaths",
    "rawResponseSha256", "projectionSha256", "attribution", "notice"
  ],
  "properties": {
    "nctId": {"type": "string", "pattern": "^NCT[0-9]{8}$"},
    "recordUrl": {"type": "string", "pattern": "^https://clinicaltrials\\.gov/study/NCT[0-9]{8}$"},
    "requestUrls": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [
        {"const": "https://clinicaltrials.gov/api/v2/version"},
        {"type": "string", "pattern": "^https://clinicaltrials\\.gov/api/v2/studies/NCT[0-9]{8}\\?fields="}
      ]
    },
    "retrievedAtUtc": {"type": "string", "format": "date-time"},
    "apiVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "dataTimestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}"},
    "requestedLeafPaths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "projectedLeafPaths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "rawResponseSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "projectionSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attribution": {"const": "ClinicalTrials.gov, U.S. National Library of Medicine"},
    "notice": {"const": "Public trial registration metadata is not patient data or clinical efficacy evidence."}
  }
}
