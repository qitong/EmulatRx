{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qitong/EmulatRx/blob/main/schemas/tte-ccw-v1.schema.json",
  "title": "EmulatRx Bilateral Grace-Period Clone-Censor-Weight (CCW) Protocol Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id",
    "protocol_version",
    "source_mode",
    "grace_period_spec",
    "covariates",
    "ipcw_spec",
    "diagnostic_gates"
  ],
  "properties": {
    "protocol_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1,
      "maxLength": 128
    },
    "protocol_version": {
      "const": "tte-ccw-v1"
    },
    "source_mode": {
      "const": "synthetic_only"
    },
    "study_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "simulation_or_data_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "grace_period_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grace_period_days",
        "period_length_days",
        "max_followup_days",
        "evaluation_horizons_days"
      ],
      "properties": {
        "grace_period_days": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "period_length_days": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_followup_days": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "evaluation_horizons_days": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "covariates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_covariates"],
      "properties": {
        "baseline_covariates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/baseline_covariate"
          }
        },
        "time_varying_covariates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/time_varying_covariate"
          }
        }
      }
    },
    "ipcw_spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "truncate_quantiles": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              }
            }
          ]
        },
        "include_admin_ipcw": {
          "type": "boolean"
        }
      }
    },
    "diagnostic_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_ess_ratio",
        "max_post_grace_smd",
        "max_stabilized_weight",
        "min_uncensored_subjects_per_clone"
      ],
      "properties": {
        "min_ess_ratio": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0
        },
        "max_post_grace_smd": {
          "type": "number",
          "exclusiveMinimum": 0.0
        },
        "max_stabilized_weight": {
          "type": "number",
          "minimum": 1.0
        },
        "min_uncensored_subjects_per_clone": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "methodological_disclaimer": {
      "type": "string"
    }
  },
  "$defs": {
    "baseline_covariate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "assessed_day_offset"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "type": {
          "type": "string",
          "enum": ["continuous", "binary"]
        },
        "assessed_day_offset": {
          "type": "number",
          "maximum": 0
        },
        "description": {
          "type": "string"
        }
      }
    },
    "time_varying_covariate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "offset_from_period_start_days"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "type": {
          "type": "string",
          "enum": ["continuous", "binary"]
        },
        "offset_from_period_start_days": {
          "type": "number",
          "exclusiveMaximum": 0
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
