{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qitong/EmulatRx/blob/main/schemas/tte-protocol-v1.schema.json",
  "title": "EmulatRx Target Trial Emulation seven-element protocol contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "study_title",
    "simulation_or_data_label",
    "eligibility",
    "time_zero",
    "treatment_strategies",
    "assignment_mode",
    "followup",
    "outcomes",
    "estimand"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "study_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "simulation_or_data_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inclusion_criteria", "exclusion_criteria"],
      "properties": {
        "inclusion_criteria": {
          "type": "array",
          "items": {"$ref": "#/$defs/criterion"}
        },
        "exclusion_criteria": {
          "type": "array",
          "items": {"$ref": "#/$defs/criterion"}
        }
      }
    },
    "time_zero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_event", "day_offset"],
      "properties": {
        "anchor_event": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "day_offset": {
          "const": 0
        },
        "landmark_day": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "type": "string"
        }
      }
    },
    "treatment_strategies": {
      "type": "array",
      "minItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "role"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "enum": ["control", "reference", "comparator"]
            },
            "description": {
              "type": "string"
            }
          }
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "role"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": ["active", "experimental"]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "assignment_mode": {
      "type": "string",
      "enum": ["observational_baseline", "observational_landmark"]
    },
    "followup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["horizon_days", "administrative_end_day"],
      "properties": {
        "horizon_days": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "administrative_end_day": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_event_code", "censor_code", "competing_event_handling"],
      "properties": {
        "primary_event_code": {
          "const": 1
        },
        "competing_event_codes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 2
          },
          "uniqueItems": true
        },
        "censor_code": {
          "const": 0
        },
        "competing_event_handling": {
          "type": "string",
          "enum": ["none", "explicit_cif_and_subdistribution"]
        }
      }
    },
    "estimand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_estimand", "effect_measures", "diagnostic_gates"],
      "properties": {
        "target_estimand": {
          "type": "string",
          "enum": ["ATE", "ATO", "PAIRWISE_ATO", "GENERALIZED_ATO"]
        },
        "effect_measures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["RD", "RR_CIF", "sHR", "csHR", "HR"]
          }
        },
        "diagnostic_gates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_abs_smd", "min_ess_ratio", "positivity_epsilon"],
          "properties": {
            "max_abs_smd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "min_ess_ratio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1.0
            },
            "positivity_epsilon": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 0.5
            }
          }
        }
      }
    },
    "covariates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "assessed_day_offset"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "type": {
            "type": "string",
            "enum": ["continuous", "binary"]
          },
          "assessed_day_offset": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "methodological_disclaimer": {
      "type": "string"
    },
    "project_mode": {
      "type": "string",
      "enum": ["synthetic_only", "simulated_cohort", "user_cohort"]
    },
    "target_rct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nct_id", "brief_title"],
      "properties": {
        "nct_id": {
          "type": "string",
          "pattern": "^NCT[0-9]{8}$"
        },
        "brief_title": {
          "type": "string",
          "minLength": 1
        },
        "record_url": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "receipt_sha256": {
          "type": "string"
        },
        "primary_outcome_measure": {
          "type": "string"
        },
        "primary_outcome_timeframe": {
          "type": "string"
        },
        "arm_alignment_status": {
          "type": "string"
        },
        "arm_alignment_warning": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "assignment_mode": {"const": "observational_baseline"}
        }
      },
      "then": {
        "properties": {
          "time_zero": {
            "properties": {
              "landmark_day": {"const": 0}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assignment_mode": {"const": "observational_landmark"}
        }
      },
      "then": {
        "properties": {
          "time_zero": {
            "required": ["landmark_day"],
            "properties": {
              "landmark_day": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "variable", "operator", "value", "assessed_day_offset"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "variable": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "enum": ["==", "!=", "<", "<=", ">", ">=", "in", "not_in"]
        },
        "value": {
          "oneOf": [
            {"type": "number"},
            {"type": "string"},
            {"type": "boolean"},
            {
              "type": "array",
              "minItems": 1,
              "items": {"type": ["number", "string", "boolean"]}
            }
          ]
        },
        "assessed_day_offset": {
          "type": "integer"
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
